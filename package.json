{
  "name": "todo-crumble",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --check src",
    "fmt:write": "oxfmt --write src"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.56.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/matter-js": "0.20.2",
    "oxfmt": "0.43.0",
    "oxlint": "1.58.0",
    "svelte": "5.55.1",
    "svelte-check": "4.4.6",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "dependencies": {
    "matter-js": "0.20.0"
  }
}
